APP_NAME="Educve LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

# ─── LMS Installer ────────────────────────────────────────────────────────────
LMS_INSTALLED=false
LMS_LICENSE_KEY=
LMS_LICENSE_API=https://manager.pmhserver.name.ng/api-docs.php
LMS_NAME="Educve LMS"
LMS_FAVICON_LETTER=L
LMS_FAVICON_BG=#6366f1
LMS_FAVICON_TEXT=#ffffff

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=lms_

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@educvelms.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── LMS Commission ───────────────────────────────────────────────────────────
LMS_COMMISSION_RATE=20
LMS_PAGE_CACHE=false

# ─── Social Login ─────────────────────────────────────────────────────────────
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ─── Integrations ─────────────────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=
GOOGLE_RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
FACEBOOK_PIXEL_ID=
TAWK_TO_PROPERTY_ID=

# ─── Zoom ─────────────────────────────────────────────────────────────────────
ZOOM_API_KEY=
ZOOM_API_SECRET=

# ─── Anti-Bruteforce ──────────────────────────────────────────────────────────
BF_USERNAME_ENABLED=true
BF_USERNAME_PERIOD=10
BF_USERNAME_MAX=5
BF_USERNAME_LOCAL_ONLY=false
BF_USERNAME_PROTECT_ADMIN=true
BF_IP_ENABLED=true
BF_IP_PERIOD=10
BF_IP_MAX=10
BF_IP_FIREWALL=false
BF_IP_DURATION=one_day
BF_IP_MAX_ONE_DAY=20
BF_IP_ONE_DAY_FIREWALL=false
BF_RETAIN_MINUTES=10
BF_WHITELIST_THRESHOLD=5
BF_NOTIFY_UNKNOWN_IP=true
BF_NOTIFY_KNOWN_NETBLOCK=false
BF_NOTIFY_BRUTEFORCE=true

# ─── Security ─────────────────────────────────────────────────────────────────
CSP_ENABLED=true

# ─── Payment Gateways ─────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

RAZORPAY_KEY=
RAZORPAY_SECRET=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

MOLLIE_KEY=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_MODE=test

# ─── AWS S3 (Optional) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEM_DISK=local

# ─── Pusher (Real-time) ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
